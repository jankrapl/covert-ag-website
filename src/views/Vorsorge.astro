  en: {
    title: 'Pension & Financial Planning: Pillar 3a, Retirement | Coverd',
    desc: 'Pension planning, wealth building and retirement: plan today instead of being surprised later. With a compound interest calculator and an annual pension check.',
    eyebrow: 'Services · Pension & Financial Planning',
    crumb: 'Pension & Financial Planning',
    h1: 'Do you know what will be left for you later?',
    lede: 'Pension planning, wealth building and retirement – plan today instead of being surprised later.',
    alt: 'An older couple walking along a ridge trail in the Jura in evening light',
    btn: 'Review Pension Plan',
    nudge: 'The earlier you plan, the more options you keep',
