---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes, ui, url, type Lang, type RouteId } from '../i18n';
import { site } from '../data/site';
import { breadcrumbs as crumbSchema } from '../lib/schema';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  route?: RouteId;
  alternates?: { de: string; en: string };
  image?: string;
  header?: 'overlay' | 'solid';
  jsonld?: object[];
  crumb?: { name: string; href?: string }[];
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { lang, title, description, route, image = 'home-hero', header = 'overlay', jsonld = [], crumb, type = 'website', noindex = false } = Astro.props;
const alternates = Astro.props.alternates ?? (route ? { de: routes[route].de, en: routes[route].en } : { de: '/', en: '/en/' });
const canonical = new URL(alternates[lang], site.url).href;
const ogImage = new URL(`/og/${image}.jpg`, site.url).href;
const altHref = lang === 'de' ? alternates.en : alternates.de;

const trail = crumb
  ? crumbSchema([{ name: ui[lang].home, href: url('home', lang) }, ...crumb.map((c) => ({ name: c.name, href: c.href ?? alternates[lang] }))])
  : null;
const schemas = trail ? [...jsonld, trail] : jsonld;
---
<!doctype html>
<html lang={lang === 'de' ? 'de-CH' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow" />}
    <link rel="alternate" hreflang="de-CH" href={new URL(alternates.de, site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.de, site.url).href} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Coverd" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b2b27" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>(function(d){d.classList.add('js');setTimeout(function(){if(!window.__coverdReady)d.classList.remove('js')},3000)})(document.documentElement)</script>
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <Header lang={lang} mode={header} route={route} altHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
