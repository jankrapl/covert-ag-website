---
// Five-step process on the dark timber photo. Cards stack as they scroll past.
import Eyebrow from './Eyebrow.astro';
import Img from './Img.astro';
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  steps: { t: string; p: string }[];
  alt: string;
  id?: string;
}
const { eyebrow, title, text, steps, alt, id } = Astro.props;
---
<section class="process" id={id}>
  <div class="process__bg"><Img name="bridge-inside" alt={alt} /></div>
  <div class="wrap process__in on-dark">
    <div class="process__head" data-reveal>
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h2>{title}</h2>
      {text && <p>{text}</p>}
      <slot />
    </div>
    <ol>
      {steps.map((s, i) => (
        <li class="step" style={`top:calc(var(--header) + ${24 + i * 14}px)`}>
          <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.t}</h3>
          <p>{s.p}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
