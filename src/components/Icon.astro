---
interface Props { name: 'arrow-up' | 'arrow' | 'chev' | 'check' | 'cross'; class?: string }
const { name, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  'arrow-up': 'M4 12 12 4M5.5 4H12v6.5',
  arrow: 'M2 8h11.5M9 3.5 13.5 8 9 12.5',
  chev: 'M2 5l6 6 6-6',
  check: 'M2.5 8.5 6.5 12.5 13.5 4',
  cross: 'M3.5 3.5 12.5 12.5M12.5 3.5 3.5 12.5',
};
---
<svg class={className} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true"><path d={paths[name]} /></svg>
