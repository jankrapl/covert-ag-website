---
import Icon from './Icon.astro';
interface Props {
  href: string;
  variant?: 'solid' | 'amber' | 'light' | 'line' | 'line-light';
  size?: 'md' | 'sm';
  external?: boolean;
}
const { href, variant = 'solid', size = 'md', external = href.startsWith('http') } = Astro.props;
const cls = ['btn', variant !== 'solid' && `btn--${variant}`, size === 'sm' && 'btn--sm'].filter(Boolean).join(' ');
---
<a class={cls} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}><span class="btn__t"><slot /></span><span class="btn__i"><Icon name="arrow-up" /></span></a>
