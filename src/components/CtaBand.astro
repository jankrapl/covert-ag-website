---
import Eyebrow from './Eyebrow.astro';
import Img from './Img.astro';
import Btn from './Btn.astro';
import { ui, url, type Lang } from '../i18n';
import { site, bookingUrl, type BookingTopic } from '../data/site';
interface Props {
  lang: Lang;
  title: string;
  text?: string;
  eyebrow?: string;
  topic?: BookingTopic;
  image?: string;
  alt?: string;
}
const { lang, title, text, eyebrow, topic, image = 'overview' } = Astro.props;
const alt = Astro.props.alt ?? (lang === 'de'
  ? 'Blick von einer Jurahöhe über das Mittelland im Morgennebel, am Horizont die Alpen'
  : 'View from a Jura ridge across the Swiss plateau in morning mist, with the Alps on the horizon');
const t = lang === 'de' ? { direct: 'Direkt', form: 'Kontaktformular' } : { direct: 'Direct', form: 'Contact form' };
---
<section class="cta">
  <div class="cta__in on-dark" data-reveal>
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <h2>{title}</h2>
    {text && <p class="lede">{text}</p>}
    <div class="btn-row"><Btn href={bookingUrl(topic)} variant="amber">{ui[lang].book}</Btn></div>
    <p class="ways">
      <span>{t.direct}</span>
      <a href={site.whatsapp.href} target="_blank" rel="noopener">WhatsApp {site.whatsapp.label}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={url('kontakt', lang)}>{t.form}</a>
    </p>
  </div>
  <div class="cta__media"><Img class="cta__img" name={image} alt={alt} sizes="(max-width: 860px) 100vw, 42vw" /></div>
</section>
